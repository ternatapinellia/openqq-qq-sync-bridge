# 默认让 git 自行判断，避免误伤
* text=auto

# Linux 侧脚本/Docker 相关文件必须是 LF，否则容器里会报
# "exec format error" 或 "$'\r': command not found"
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
entrypoint.sh text eol=lf
.dockerignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 源码统一 LF
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows 批处理需要 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制
*.exe binary
*.zip binary
*.db binary
*.bak binary